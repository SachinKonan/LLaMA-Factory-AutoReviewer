\begin{tabular}{l|cc|cc|cc}
\toprule
& \multicolumn{2}{c|}{\textbf{ICLR 2025}} & \multicolumn{2}{c|}{\textbf{ICLR 2026}} & \multicolumn{2}{c}{\textbf{Overall}} \\
\textbf{Transition} & \textbf{\%} & \textbf{Acc.} & \textbf{\%} & \textbf{Acc.} & \textbf{\%} & \textbf{Acc.} \\
