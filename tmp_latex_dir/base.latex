        \midrule
        2020 & 6.25 & 3.67 & 2.58 \\
        2021 & 6.53 & 5.03 & 1.50 \\
        2022 & 6.62 & 4.67 & 1.95 \\
        2023 & 6.60 & 4.67 & 1.93 \\
        2025 & 6.47 & 4.80 & 1.67 \\
        \textbf{2026} & \textbf{5.40} & \textbf{3.96} & \textbf{1.44} \\
        \bottomrule
